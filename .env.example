# A recopier dans Vercel > Settings > Environment Variables.
# Aucune de ces valeurs ne doit etre commitee.

# Optionnel : token System User ads_read dedie au dashboard. Vide = le token d'ecriture sert aussi a la lecture.
META_ACCESS_TOKEN=

# Token System User avec ads_management : creation des campagnes EN PAUSE depuis le generator.
# Noms acceptes : META_SYSTEM_USER_TOKEN, META_SYSTEM_USER, META_WRITE_TOKEN.
META_SYSTEM_USER_TOKEN=

# Mot de passe des outils internes, partage Antoine / Sacha. Prefere une phrase de 4 mots ou plus.
TOOLS_PASSWORD=

# Optionnel : cle de signature des liens client et des uploads. Vide = derivee du token Meta.
SIGNING_SECRET=

# Airtable : PAT limite a la base Clients, scopes data.records:read + data.records:write.
AIRTABLE_TOKEN=
# Optionnel, defaut appZkmKmtuYYq2lgG
AIRTABLE_BASE_ID=

# Google Drive (Workspace 129) : cle JSON complete du compte de service, sur une ligne.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Dossier racine des onboardings, dans un Drive partage dont le compte de service est membre.
DRIVE_PARENT_FOLDER_ID=

# Optionnel : URL publique du formulaire client (ex. https://129agency.com/onboarding)
PUBLIC_FORM_BASE=

# Optionnel
META_API_VERSION=v23.0
